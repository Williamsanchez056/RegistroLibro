
@namespace RegistroLibro.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
<button class="btn @GetButtonClass()" @onclick="OnClick">@ChildContent</button>
@code {
    [Parameter]
    public ButtonColor Color { get; set; } = ButtonColor.Primary;
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    private string GetButtonClass()
    {
        return Color switch
        {
            ButtonColor.Primary => "btn-primary",
            ButtonColor.Secondary => "btn-secondary",
            ButtonColor.Danger => "btn-danger",
            ButtonColor.Success => "btn-success",
            _ => "btn-primary",
        };
    }
}
