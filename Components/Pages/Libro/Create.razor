@page "/Libro/crear"
@using RegistroLibro.Models
@using RegistroLibro.Services
@inject LibroService Servicio
@inject NavigationManager navigationManager
@inject ToastService toastService
@rendermode InteractiveServer
<PageTitle>Crear Libro</PageTitle>
<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h5>Registro de Libro</h5>
        </div>
        <div class="card-body">
            <EditForm Model="libro" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-3">
                    <label class="form-label">Titulo</label>
                    <InputText class="form-control" @bind-Value="libro.Titulo" />
                    <ValidationMessage For="@(() => libro.Titulo)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Autor</label>
                    <InputText class="form-control" @bind-Value="libro.Autor" />
                    <ValidationMessage For="@(() => libro.Autor)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Año de Publicacion</label>
                    <InputNumber class="form-control" @bind-Value="libro.AnoPublicacion" />
                    <ValidationMessage For="@(() => libro.AnoPublicacion)" />
                </div>
                <button type="submit" class="btn btn-primary">Guardar</button>
                <button type="button" class="btn btn-secondary ms-2" @onclick="Volver">Cancelar</button>
            </EditForm>
        </div>
    </div>
</div>
@code {
    private Libro libro = new();
    private async Task Guardar()
    {
        var resultado = await Servicio.Guardar(libro);
        if (resultado)
        {
            toastService.ShowSuccess("Libro guardado correctamente.");
            navigationManager.NavigateTo("/Libro");
        }
        else
        {
            toastService.ShowError("Ya existe un libro con ese titulo.");
        }
    }
    private void Volver()
    {
        navigationManager.NavigateTo("/Libro");
    }
}
