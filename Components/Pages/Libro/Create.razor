@page "/libros/crear"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using RegistroLibro.Models
@using RegistroLibro.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode

@inject LibroService Servicio
@inject NavigationManager navigationManager

<PageTitle>Crear libro</PageTitle>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Crear libro</h3>
    </div>

    <div class="card-body">
        <EditForm Model="libro"
                  OnValidSubmit="Guardar"
                  FormName="CrearLibro"
                  @key="libro">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="titulo" class="form-label">Titulo</label>
                <InputText id="titulo"
                           class="form-control"
                           @bind-value="libro.Titulo" />
                <ValidationMessage For="@(() => libro.Titulo)" />
            </div>

            <div class="mb-3">
                <label for="autor" class="form-label">Autor</label>
                <InputText id="autor"
                           class="form-control"
                           @bind-value="libro.Autor" />
                <ValidationMessage For="@(() => libro.Autor)" />
            </div>

            <div class="mb-3">
                <label for="ano" class="form-label">
                    Año de publicacion
                </label>

                <InputNumber id="ano"
                             class="form-control"
                             @bind-value="libro.AnoPublicacion" />

                <ValidationMessage For="@(() => libro.AnoPublicacion)" />
            </div>

            <button type="submit"
                    class="btn btn-success"
                    disabled="@guardando">
                @(guardando ? "Guardando..." : "Guardar")
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="Volver">
                Volver
            </button>

        </EditForm>
    </div>
</div>

@code {
    private Libro libro = new();
    private bool guardando;

    private async Task Guardar()
    {
        if (guardando)
            return;

        guardando = true;

        try
        {
            if (await Servicio.Guardar(libro))
            {
                toastService.ShowSuccess("Libro guardado correctamente.");
                navigationManager.NavigateTo("/libros");
            }
            else
            {
                toastService.ShowError("No se pudo guardar el libro.");
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private void Volver()
    {
        navigationManager.NavigateTo("/libros");
    }
}