@page "/libros"
@rendermode InteractiveServer
@using RegistroLibro.Models
@using RegistroLibro.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject LibroService Servicio

<PageTitle>Consulta de libros</PageTitle>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Consulta de libros</h3>
    </div>

    <div class="card-body">
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label">Filtrar por</label>
                <select class="form-select" @bind="filtro">
                    <option value="Titulo">Titulo</option>
                    <option value="Autor">Autor</option>
                    <option value="LibroId">ID</option>
                    <option value="AnoPublicacion">Año de publicacion</option>
                </select>
            </div>

            <div class="col-md-5">
                <label class="form-label">Buscar</label>
                <input class="form-control"
                       @bind="busqueda"
                       placeholder="Escribe tu busqueda" />
            </div>

            <div class="col-md-4 d-flex align-items-end gap-2">
                <button class="btn btn-primary" @onclick="Buscar">
                    Buscar
                </button>

                <button class="btn btn-secondary" @onclick="Restablecer">
                    Restablecer
                </button>
            </div>
        </div>

        <a class="btn btn-success mb-3" href="/libros/crear">
            Crear libro
        </a>

        @if (cargando)
        {
            <p>Cargando libros...</p>
        }
        else if (libros.Count == 0)
        {
            <div class="alert alert-info">
                No se encontraron libros.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Titulo</th>
                            <th>Autor</th>
                            <th>Año de publicacion</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var libro in libros)
                        {
                            <tr @key="libro.LibroId">
                                <td>@libro.LibroId</td>
                                <td>@libro.Titulo</td>
                                <td>@libro.Autor</td>
                                <td>@libro.AnoPublicacion</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a class="btn btn-warning btn-sm"
                                           href="@($"/libros/editar/{libro.LibroId}")">
                                            Editar
                                        </a>

                                        <a class="btn btn-danger btn-sm"
                                           href="@($"/libros/eliminar/{libro.LibroId}")">
                                            Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="text-muted">Total: @libros.Count libros</p>
        }
    </div>
</div>

@code {
    private List<Libro> libros = new();
    private string filtro = "Titulo";
    private string busqueda = "";
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await Buscar();
    }

    private async Task Buscar()
    {
        cargando = true;

        try
        {
            var texto = busqueda.Trim();

            if (string.IsNullOrWhiteSpace(texto))
            {
                libros = await Servicio.GetList(l => true);
            }
            else if (filtro == "Titulo")
            {
                libros = await Servicio.GetList(l =>
                    l.Titulo.Contains(texto));
            }
            else if (filtro == "Autor")
            {
                libros = await Servicio.GetList(l =>
                    l.Autor.Contains(texto));
            }
            else if (int.TryParse(texto, out int numero))
            {
                libros = filtro == "LibroId"
                    ? await Servicio.GetList(l => l.LibroId == numero)
                    : await Servicio.GetList(l => l.AnoPublicacion == numero);
            }
            else
            {
                libros = new();
            }
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Restablecer()
    {
        filtro = "Titulo";
        busqueda = "";
        await Buscar();
    }
}