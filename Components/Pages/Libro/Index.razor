@page "/libros"
@rendermode InteractiveServer
@using RegistroLibro.Models
@using RegistroLibro.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject LibroService Servicio

<PageTitle>Consulta de libros</PageTitle>

<h3>Consulta de libros</h3>

<a class="btn btn-primary mb-3" href="/libros/crear">
    Crear libro
</a>

<div class="row mb-3">
    <div class="col-md-3">
        <label for="filtro" class="form-label">Filtrar por</label>

        <select id="filtro" class="form-select" @bind="filtro">
            <option value="Titulo">Titulo</option>
            <option value="Autor">Autor</option>
            <option value="LibroId">LibroId</option>
            <option value="AnoPublicacion">Ano de publicacion</option>
        </select>
    </div>

    <div class="col-md-6">
        <label for="busqueda" class="form-label">Busqueda</label>

        <input id="busqueda"
               class="form-control"
               @bind="busqueda"
               placeholder="Escribe para buscar" />
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button class="btn btn-success" @onclick="Buscar">
            Buscar
        </button>
    </div>
</div>

@if (cargando)
{
    <p>Cargando tus libros...</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>LibroId</th>
                <th>Titulo</th>
                <th>Autor</th>
                <th>Ano de publicacion</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var libro in libros)
            {
                <tr>
                    <td>@libro.LibroId</td>
                    <td>@libro.Titulo</td>
                    <td>@libro.Autor</td>
                    <td>@libro.AnoPublicacion</td>
                    <td>
                        <a class="btn btn-warning btn-sm"
                           href="@($"/libros/editar/{libro.LibroId}")">
                            Editar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (libros.Count == 0)
    {
        <p>No se encontraron tus libros.</p>
    }

    <p><strong>Cantidad: @libros.Count</strong></p>
}

@code {
    private List<Libro> libros = new();
    private string filtro = "Titulo";
    private string busqueda = string.Empty;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await Buscar();
        cargando = false;
    }

    private async Task Buscar()
    {
        var todos = await Servicio.Listar();
        var texto = busqueda.Trim();

        if (string.IsNullOrWhiteSpace(texto))
        {
            libros = todos;
            return;
        }

        libros = filtro switch
        {
            "LibroId" => todos
                .Where(l => l.LibroId.ToString() == texto)
                .ToList(),

            "Autor" => todos
                .Where(l => l.Autor.Contains(
                    texto, StringComparison.OrdinalIgnoreCase))
                .ToList(),

            "AnoPublicacion" => todos
                .Where(l => l.AnoPublicacion.ToString() == texto)
                .ToList(),

            _ => todos
                .Where(l => l.Titulo.Contains(
                    texto, StringComparison.OrdinalIgnoreCase))
                .ToList()
        };
    }
}