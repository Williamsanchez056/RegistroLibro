@page "/Libro/editar/{Id:int}"
@using RegistroLibro.Models
@using RegistroLibro.Services
@inject LibroService Servicio
@inject NavigationManager navigationManager
@inject ToastService toastService
@rendermode InteractiveServer
<PageTitle>Editar Libro</PageTitle>
<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h5>Editar Libro</h5>
        </div>
        <div class="card-body">
            @if (libro is null)
            {
                <p>Cargando...</p>
            }
            else
            {
                <EditForm Model="libro" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label class="form-label">Titulo</label>
                        <InputText class="form-control" @bind-Value="libro.Titulo" />
                        <ValidationMessage For="@(() => libro.Titulo)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Autor</label>
                        <InputText class="form-control" @bind-Value="libro.Autor" />
                        <ValidationMessage For="@(() => libro.Autor)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Año de Publicacion</label>
                        <InputNumber class="form-control" @bind-Value="libro.AnoPublicacion" />
                        <ValidationMessage For="@(() => libro.AnoPublicacion)" />
                    </div>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="Volver">Cancelar</button>
                </EditForm>
            }
        </div>
    </div>
</div>
@code {
    [Parameter]
    public int Id { get; set; }
    private Libro? libro;
    protected override async Task OnInitializedAsync()
    {
        libro = await Servicio.Buscar(Id);
        if (libro is null)
        {
            navigationManager.NavigateTo("/Libro");
        }
    }
    private async Task Guardar()
    {
        if (libro is null)
            return;
        var resultado = await Servicio.Guardar(libro);
        if (resultado)
        {
            toastService.ShowSuccess("Libro actualizado correctamente.");
            navigationManager.NavigateTo("/Libro");
        }
        else
        {
            toastService.ShowError("Ya existe un libro con ese titulo.");
        }
    }
    private void Volver()
    {
        navigationManager.NavigateTo("/Libro");
    }
}
