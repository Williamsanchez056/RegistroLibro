@page "/libros/editar/{LibroId:int}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using RegistroLibro.Models
@using RegistroLibro.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject LibroService Servicio

<PageTitle>Editar libro</PageTitle>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Editar libro</h3>
    </div>

    <div class="card-body">
        @if (cargando)
        {
            <p>Cargando libro...</p>
        }
        else if (libro is null)
        {
            <div class="alert alert-warning">
                No se encontro el libro.
            </div>

            <a class="btn btn-secondary" href="/libros">
                Volver
            </a>
        }
        else
        {
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert @tipoAlerta" role="alert">
                    @mensaje
                </div>
            }

            <EditForm Model="libro"
                      OnValidSubmit="Guardar"
                      FormName="EditarLibro">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="libroId" class="form-label">ID</label>
                    <input id="libroId"
                           class="form-control"
                           value="@libro.LibroId"
                           readonly />
                </div>

                <div class="mb-3">
                    <label for="titulo" class="form-label">Titulo</label>
                    <InputText id="titulo"
                               class="form-control"
                               @bind-Value="libro.Titulo" />
                    <ValidationMessage For="@(() => libro.Titulo)" />
                </div>

                <div class="mb-3">
                    <label for="autor" class="form-label">Autor</label>
                    <InputText id="autor"
                               class="form-control"
                               @bind-Value="libro.Autor" />
                    <ValidationMessage For="@(() => libro.Autor)" />
                </div>

                <div class="mb-3">
                    <label for="ano" class="form-label">
                        Año de publicacion
                    </label>
                    <InputNumber id="ano"
                                 class="form-control"
                                 @bind-Value="libro.AnoPublicacion" />
                    <ValidationMessage For="@(() => libro.AnoPublicacion)" />
                </div>

                <button type="submit"
                        class="btn btn-success"
                        disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar cambios")
                </button>

                <a class="btn btn-secondary" href="/libros">
                    Volver
                </a>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter]
    public int LibroId { get; set; }

    private Libro? libro;
    private bool cargando = true;
    private bool guardando;
    private string mensaje = "";
    private string tipoAlerta = "alert-danger";

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        mensaje = "";

        try
        {
            libro = await Servicio.Buscar(LibroId);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Guardar()
    {
        if (libro is null || guardando)
            return;

        guardando = true;
        mensaje = "";

        try
        {
            if (await Servicio.Guardar(libro))
            {
                tipoAlerta = "alert-success";
                mensaje = "Libro actualizado correctamente.";
            }
            else
            {
                tipoAlerta = "alert-danger";
                mensaje = "Ya existe otro libro con ese titulo.";
            }
        }
        finally
        {
            guardando = false;
        }
    }
}