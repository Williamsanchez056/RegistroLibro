@page "/Libro/editar/{Id:int}"
@using RegistroLibro.Models
@using RegistroLibro.Services
@inject LibrosService Servicio
@inject NavigationManager navigationManager
@inject ToastService toastService
@rendermode InteractiveServer

<PageTitle>Editar Libro</PageTitle>

<div class="container mt-4">
    <div class="card">
        <div class="card-header"><h5>Editar Libro</h5></div>
        <div class="card-body">
            @if (libro is null)
            {
                <p>Cargando...</p>
            }
            else
            {
                <EditForm Model="libro" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label class="form-label">Titulo</label>
                        <InputText class="form-control" @bind-Value="libro.Titulo" />
                        <ValidationMessage For="@(() => libro.Titulo)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Autor</label>
                        <InputText class="form-control" @bind-Value="libro.Autor" />
                        <ValidationMessage For="@(() => libro.Autor)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ano de Publicacion</label>
                        <InputNumber class="form-control" @bind-Value="libro.AnoPublicacion" />
                        <ValidationMessage For="@(() => libro.AnoPublicacion)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cantidad Disponible</label>
                        <InputNumber class="form-control" @bind-Value="libro.CantidadDisponible" />
                        <ValidationMessage For="@(() => libro.CantidadDisponible)" />
                    </div>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <button type="button" class="btn btn-danger ms-2" @onclick="Eliminar">Eliminar</button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="Volver">Cancelar</button>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Libro? libro;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await Servicio.Buscar(Id);
        if (resultado.IsSuccess)
            libro = resultado.Value;
        else
        {
            toastService.ShowError(resultado.Error.Description);
            navigationManager.NavigateTo("/Libro");
        }
    }

    private async Task Guardar()
    {
        if (libro is null) return;

        var resultado = await Servicio.Guardar(libro);
        if (resultado.IsSuccess)
        {
            toastService.ShowSuccess("Libro actualizado correctamente.");
            navigationManager.NavigateTo("/Libro");
        }
        else
            toastService.ShowError(resultado.Error.Description);
    }

    private async Task Eliminar()
    {
        var resultado = await Servicio.Eliminar(Id);
        if (resultado.IsSuccess)
        {
            toastService.ShowSuccess("Libro eliminado correctamente.");
            navigationManager.NavigateTo("/Libro");
        }
        else
            toastService.ShowError(resultado.Error.Description);
    }

    private void Volver() => navigationManager.NavigateTo("/Libro");
}