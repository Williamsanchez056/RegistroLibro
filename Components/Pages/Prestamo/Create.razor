@page "/prestamos/crear"
@using RegistroLibro.Models
@using RegistroLibro.Services
@inject PrestamosService PrestamoService
@inject NavigationManager Navigation
@rendermode InteractiveServer
<div class="container mt-4">
    <div class="card shadow-sm border-0 col-md-8 mx-auto">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0">
                <i class="bi bi-bookmark-plus-fill me-2"></i>Registrar Nuevo Prestamo
            </h4>
        </div>
        <div class="card-body p-4">
            <EditForm Model="nuevoPrestamo" OnValidSubmit="GuardarPrestamo">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Nombre del Estudiante:</label>
                    <InputText class="form-control" placeholder="Ej: Williams Rafael" @bind-value="nuevoPrestamo.Estudiante" />
                    <ValidationMessage For="@(() => nuevoPrestamo.Estudiante)" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Libro:</label>
                    <InputText class="form-control" placeholder="Ej: El quijote" @bind-value="nuevoPrestamo.Libro" />
                    <ValidationMessage For="@(() => nuevoPrestamo.Libro)" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Fecha de Prestamo:</label>
                        <InputDate class="form-control" @bind-value="nuevoPrestamo.FechaPrestamo" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Fecha de Devolucion:</label>
                        <InputDate class="form-control" @bind-value="nuevoPrestamo.FechaDevolucion" />
                        <ValidationMessage For="@(() => nuevoPrestamo.FechaDevolucion)" />
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="prestamos" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>Guardar Prestamo
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>
@code {
    private Prestamo nuevoPrestamo = new();
    private async Task GuardarPrestamo()
    {
        var guardado = await PrestamoService.Guardar(nuevoPrestamo);
        if (guardado)
        {
            Navigation.NavigateTo("prestamos");
        }
    }
}

