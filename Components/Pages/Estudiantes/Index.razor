@page "/estudiantes"
@rendermode InteractiveServer

@using RegistroLibro.Models
@using RegistroLibro.Services
@using Microsoft.AspNetCore.Components.QuickGrid

@inject EstudiantesService Servicio
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Consulta de estudiantes</PageTitle>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Consulta de estudiantes</h3>
    </div>

    <div class="card-body">

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label for="busqueda" class="form-label">
                    Buscar por nombre
                </label>

                <input id="busqueda"
                       class="form-control"
                       @bind="busqueda"
                       placeholder="Escribe un nombre" />
            </div>

            <div class="col-md-6 d-flex align-items-end gap-2">

                <button class="btn btn-primary"
                        @onclick="Buscar">
                    Buscar
                </button>

                <button class="btn btn-secondary"
                        @onclick="Restablecer">
                    Restablecer
                </button>

            </div>
        </div>

        <button class="btn btn-success mb-3"
                @onclick="Nuevo">
            Nuevo estudiante
        </button>

        @if (cargando)
        {
            <p>Cargando estudiantes...</p>
        }
        else
        {
            <QuickGrid Items="estudiantes.AsQueryable()"
                       Class="table table-hover table-striped align-middle">

                <PropertyColumn Property="@(e => e.EstudianteId)"
                                Title="ID"
                                Sortable="true" />

                <PropertyColumn Property="@(e => e.Nombres)"
                                Title="Nombres"
                                Sortable="true" />

                <PropertyColumn Property="@(e => e.Direccion)"
                                Title="Dirección"
                                Sortable="true" />

                <PropertyColumn Property="@(e => e.Email)"
                                Title="Email"
                                Sortable="true" />

                <PropertyColumn Property="@(e => e.FechaNacimiento)"
                                Title="Fecha de nacimiento"
                                Format="dd/MM/yyyy"
                                Sortable="true" />

                <TemplateColumn Title="Opciones">
                    <div class="d-flex gap-2">
                        <a href="/estudiantes/editar/@context.EstudianteId"
                           class="btn btn-outline-primary btn-sm d-inline-flex align-items-center">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Editar
                        </a>

                        <button type="button"
                                class="btn btn-outline-danger btn-sm d-inline-flex align-items-center"
                                @onclick="() => MostrarModal(context.EstudianteId)">
                            <i class="bi bi-trash me-1"></i> Eliminar
                        </button>
                    </div>
                </TemplateColumn>

            </QuickGrid>

            <p class="text-muted mt-3">
                Total: @estudiantes.Count estudiantes
            </p>
        }

    </div>
</div>

<Modal @ref="modal">
    <div class="modal-header">
        <h5 class="modal-title">Eliminar estudiante</h5>
        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
    </div>

    <div class="modal-body">
        ¿Está seguro de que desea eliminar este estudiante?
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                @onclick="CerrarModal">
            Cancelar
        </button>

        <button type="button"
                class="btn btn-danger"
                @onclick="Eliminar">
            Eliminar
        </button>
    </div>
</Modal>

@code {
    private List<Estudiante> estudiantes = new();
    private string busqueda = "";
    private bool cargando = true;

    private int estudianteId;

    private Modal modal = default!;

    protected override async Task OnInitializedAsync()
    {
        await Buscar();
    }

    private async Task Buscar()
    {
        cargando = true;

        var texto = busqueda.Trim();

        estudiantes = string.IsNullOrWhiteSpace(texto)
            ? await Servicio.Listar()
            : await Servicio.GetList(e => e.Nombres.Contains(texto));

        cargando = false;
    }

    private async Task Restablecer()
    {
        busqueda = "";
        await Buscar();
    }

    private void Nuevo()
    {
        navigationManager.NavigateTo("/estudiantes/crear");
    }

    private async Task MostrarModal(int id)
    {
        estudianteId = id;
        await modal.ShowAsync();
    }

    private async Task CerrarModal()
    {
        await modal.HideAsync();
    }

    private async Task Eliminar()
    {
        if (await Servicio.Eliminar(estudianteId))
        {
            toastService.ShowSuccess("Estudiante eliminado correctamente.");
            await Buscar();
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el estudiante.");
        }

        await modal.HideAsync();
    }
}