@page "/devoluciones/crear"
@page "/devoluciones/crear/{PrestamoId:int}"
@using RegistroLibro.Models
@using RegistroLibro.Services
@inject DevolucionesService Servicio
@inject PrestamosService PrestamoService
@inject NavigationManager Navigation
@inject ToastService toastService
@rendermode InteractiveServer

<PageTitle>Registrar devolución</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm border-0 col-md-8 mx-auto">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0">
                <i class="bi bi-arrow-return-left me-2"></i>Registrar devolución
            </h4>
        </div>

        <div class="card-body p-4">
            @if (prestamosDisponibles.Count == 0)
            {
                <div class="alert alert-info">
                    No hay préstamos pendientes de devolución.
                </div>
                <a href="/prestamos" class="btn btn-secondary">Volver a préstamos</a>
            }
            else
            {
                <EditForm Model="devolucion" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Préstamo</label>
                        <InputSelect class="form-select" @bind-Value="devolucion.PrestamoId">
                            <option value="0">Seleccione un préstamo...</option>
                            @foreach (var prestamo in prestamosDisponibles)
                            {
                                <option value="@prestamo.PrestamoId">
                                    #@prestamo.PrestamoId - @prestamo.Estudiante / @prestamo.Libro
                                </option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => devolucion.PrestamoId)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Fecha de devolución</label>
                        <InputDate class="form-control" @bind-Value="devolucion.FechaDevolucion" />
                        <ValidationMessage For="@(() => devolucion.FechaDevolucion)" />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="/devoluciones" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle me-1"></i>Guardar devolución
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int PrestamoId { get; set; }

    private Devolucion devolucion = new();
    private List<Prestamo> prestamosDisponibles = new();

    protected override async Task OnInitializedAsync()
    {
        prestamosDisponibles = await PrestamoService.GetList(p => p.FechaEntrega == null);

        if (PrestamoId > 0 && prestamosDisponibles.Any(p => p.PrestamoId == PrestamoId))
            devolucion.PrestamoId = PrestamoId;
    }

    private async Task Guardar()
    {
        var guardado = await Servicio.Guardar(devolucion);

        if (guardado)
        {
            toastService.ShowSuccess("Devolución registrada correctamente.");
            Navigation.NavigateTo("/devoluciones");
        }
        else
        {
            toastService.ShowError("No se pudo registrar. Verifica que el préstamo siga pendiente y que la fecha sea válida.");
            prestamosDisponibles = await PrestamoService.GetList(p => p.FechaEntrega == null);
        }
    }
}
