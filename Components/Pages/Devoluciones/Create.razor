@page "/devoluciones/crear"
@page "/devoluciones/crear/{PrestamoId:int}"
@using RegistroLibro.Models
@using RegistroLibro.Services
@inject DevolucionesService Servicio
@inject PrestamosService PrestamoService
@inject NavigationManager Navigation
@inject ToastService toastService
@rendermode InteractiveServer

<PageTitle>Registrar devolucion</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm border-0 col-md-8 mx-auto">
        <div class="card-header bg-primary text-white py-3"><h4 class="mb-0"><i class="bi bi-arrow-return-left me-2"></i>Registrar devolucion</h4></div>
        <div class="card-body p-4">
            @if (prestamosDisponibles.Count == 0)
            {
                <div class="alert alert-info">No hay prestamos pendientes de devolucion.</div>
                <a href="/prestamos" class="btn btn-secondary">Volver a prestamos</a>
            }
            else
            {
                <EditForm Model="devolucion" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Prestamo</label>
                        <InputSelect class="form-select" @bind-Value="devolucion.PrestamoId">
                            <option value="0">Seleccione un prestamo...</option>
                            @foreach (var prestamo in prestamosDisponibles)
                            {
                                <option value="@prestamo.PrestamoId">#@prestamo.PrestamoId - @prestamo.Estudiante / @prestamo.Libro</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => devolucion.PrestamoId)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Fecha de devolucion</label>
                        <InputDate class="form-control" @bind-Value="devolucion.FechaDevolucion" />
                        <ValidationMessage For="@(() => devolucion.FechaDevolucion)" />
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="/devoluciones" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-1"></i>Guardar devolucion</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int PrestamoId { get; set; }
    private Devolucion devolucion = new();
    private List<Prestamo> prestamosDisponibles = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarPrestamosDisponibles();
        if (PrestamoId > 0 && prestamosDisponibles.Any(p => p.PrestamoId == PrestamoId))
            devolucion.PrestamoId = PrestamoId;
    }

    private async Task CargarPrestamosDisponibles()
    {
        var resultado = await PrestamoService.GetList(p => p.FechaEntrega == null);
        if (resultado.IsSuccess)
            prestamosDisponibles = resultado.Value;
        else
        {
            prestamosDisponibles = new();
            toastService.ShowError(resultado.Error.Description);
        }
    }

    private async Task Guardar()
    {
        var resultado = await Servicio.Guardar(devolucion);
        if (resultado.IsSuccess)
        {
            toastService.ShowSuccess("Devolucion registrada correctamente.");
            Navigation.NavigateTo("/devoluciones");
        }
        else
        {
            toastService.ShowError(resultado.Error.Description);
            await CargarPrestamosDisponibles();
        }
    }
}