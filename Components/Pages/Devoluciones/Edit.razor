@page "/devoluciones/editar/{Id:int}"
@using RegistroLibro.Models
@using RegistroLibro.Services
@inject DevolucionesService Servicio
@inject NavigationManager Navigation
@inject ToastService toastService
@rendermode InteractiveServer

<PageTitle>Editar devolucion</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm border-0 col-md-8 mx-auto">
        <div class="card-header bg-primary text-white py-3"><h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Editar devolucion</h4></div>
        <div class="card-body p-4">
            @if (cargando)
            {
                <p class="text-muted">Cargando devolucion...</p>
            }
            else if (!encontrada || devolucion is null)
            {
                <div class="alert alert-warning">No se encontro la devolucion solicitada.</div>
                <a href="/devoluciones" class="btn btn-secondary">Volver</a>
            }
            else
            {
                <EditForm Model="devolucion" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Prestamo</label>
                        <input class="form-control" value="@($"#{devolucion.PrestamoId} - {devolucion.Prestamo?.Estudiante} / {devolucion.Prestamo?.Libro}")" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Fecha de devolucion</label>
                        <InputDate class="form-control" @bind-Value="devolucion.FechaDevolucion" />
                        <ValidationMessage For="@(() => devolucion.FechaDevolucion)" />
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="/devoluciones" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-1"></i>Guardar cambios</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Devolucion? devolucion;
    private bool cargando = true;
    private bool encontrada;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await Servicio.Buscar(Id);
        if (resultado.IsSuccess)
        {
            devolucion = resultado.Value;
            encontrada = devolucion is not null;
        }
        else
            toastService.ShowError(resultado.Error.Description);

        cargando = false;
    }

    private async Task Guardar()
    {
        if (devolucion is null) return;
        var resultado = await Servicio.Guardar(devolucion);
        if (resultado.IsSuccess)
        {
            toastService.ShowSuccess("Devolucion actualizada correctamente.");
            Navigation.NavigateTo("/devoluciones");
        }
        else
            toastService.ShowError(resultado.Error.Description);
    }
}