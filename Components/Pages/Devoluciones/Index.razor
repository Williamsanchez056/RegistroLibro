@page "/devoluciones"
@using RegistroLibro.Models
@using RegistroLibro.Services
@inject DevolucionesService Servicio
@inject NavigationManager Navigation
@inject ToastService toastService
@rendermode InteractiveServer

<PageTitle>Consulta de devoluciones</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0"><i class="bi bi-arrow-return-left me-2"></i>Consulta de devoluciones</h4>
            <a href="/devoluciones/crear" class="btn btn-light btn-sm text-primary fw-bold"><i class="bi bi-plus-circle me-1"></i>Registrar devolucion</a>
        </div>
        <div class="card-body">
            <div class="row mb-3 g-2 align-items-center">
                <div class="col-md-6"><input class="form-control" placeholder="Buscar por estudiante o libro..." @bind="terminoBusqueda" @bind:event="oninput" /></div>
                <div class="col-md-6 text-md-end text-muted">Total: <strong>@DevolucionesFiltradas.Count</strong></div>
            </div>
            @if (cargando)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><span class="visually-hidden">Cargando...</span></div>
            }
            else if (!DevolucionesFiltradas.Any())
            {
                <div class="alert alert-info text-center my-4">Todavia no hay devoluciones registradas.</div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-hover align-middle">
                    <thead class="table-light"><tr><th>#</th><th>Estudiante</th><th>Libro</th><th>Fecha de prestamo</th><th>Fecha de devolucion</th><th>Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var item in DevolucionesFiltradas)
                        {
                            <tr>
                                <td><strong>@item.DevolucionId</strong></td><td>@(item.Prestamo?.Estudiante ?? "—")</td><td>@(item.Prestamo?.Libro ?? "—")</td>
                                <td>@(item.Prestamo?.FechaPrestamo.ToString("dd/MM/yyyy") ?? "—")</td><td>@item.FechaDevolucion.ToString("dd/MM/yyyy")</td>
                                <td><div class="d-flex gap-2">
                                    <a href="/devoluciones/editar/@item.DevolucionId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-square me-1"></i>Editar</a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => PrepararEliminacion(item.DevolucionId)"><i class="bi bi-trash me-1"></i>Eliminar</button>
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div>
    </div>
</div>

<Modal @ref="modal" Title="Eliminar devolucion">
    <BodyTemplate><p>¿Deseas eliminar esta devolucion? El prestamo volvera a quedar pendiente.</p></BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
        <button type="button" class="btn btn-danger" @onclick="Eliminar">Si, eliminar</button>
    </FooterTemplate>
</Modal>

@code {
    private List<Devolucion> devoluciones = new();
    private string terminoBusqueda = string.Empty;
    private bool cargando = true;
    private int devolucionIdAEliminar;
    private Modal modal = default!;

    private List<Devolucion> DevolucionesFiltradas =>
        string.IsNullOrWhiteSpace(terminoBusqueda)
            ? devoluciones
            : devoluciones.Where(d =>
                (d.Prestamo?.Estudiante?.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (d.Prestamo?.Libro?.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        cargando = true;
        var resultado = await Servicio.GetList(d => true);
        if (resultado.IsSuccess)
            devoluciones = resultado.Value;
        else
        {
            devoluciones = new();
            toastService.ShowError(resultado.Error.Description);
        }
        cargando = false;
    }

    private async Task PrepararEliminacion(int id)
    {
        devolucionIdAEliminar = id;
        await modal.ShowAsync();
    }

    private async Task CerrarModal() => await modal.HideAsync();

    private async Task Eliminar()
    {
        var resultado = await Servicio.Eliminar(devolucionIdAEliminar);
        if (resultado.IsSuccess)
        {
            toastService.ShowSuccess("Devolucion eliminada. El prestamo quedo pendiente.");
            await CargarDatos();
        }
        else
            toastService.ShowError(resultado.Error.Description);

        await modal.HideAsync();
    }
}