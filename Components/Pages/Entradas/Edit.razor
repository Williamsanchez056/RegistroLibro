@page "/Entradas/editar/{Id:int}"

@using RegistroLibro.Models
@using RegistroLibro.Services

@inject EntradasService Servicio
@inject LibrosService LibrosServicio
@inject NavigationManager navigationManager
@inject ToastService toastService

@rendermode InteractiveServer

<PageTitle>Editar Entrada</PageTitle>

<div class="container mt-4">
    <div class="card">
        <div class="card-header"><h5>Editar Entrada de Libros</h5></div>
        <div class="card-body">
            @if (cargando)
            {
                <p>Cargando entrada...</p>
            }
            else
            {
                <EditForm Model="entrada" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Fecha</label>
                        <InputDate class="form-control" @bind-Value="entrada.Fecha" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Concepto</label>
                        <InputText class="form-control" @bind-Value="entrada.Concepto" />
                        <ValidationMessage For="@(() => entrada.Concepto)" />
                    </div>

                    <div class="border rounded p-3 mb-3">
                        <h6>Detalle de libros</h6>

                        <div class="row g-2 align-items-end">
                            <div class="col-md-7">
                                <label class="form-label">Libro</label>
                                <InputSelect class="form-select" @bind-Value="libroSeleccionadoId">
                                    <option value="0">Selecciona un libro</option>
                                    @foreach (var libro in libros)
                                    {
                                        <option value="@libro.LibroId">@libro.Titulo (@libro.CantidadDisponible disponibles)</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Cantidad</label>
                                <InputNumber class="form-control" @bind-Value="cantidadDetalle" min="1" />
                            </div>

                            <div class="col-md-2">
                                <button type="button" class="btn btn-outline-primary w-100" @onclick="AgregarLibro">
                                    Agregar
                                </button>
                            </div>
                        </div>

                        @if (entrada.Detalles.Count > 0)
                        {
                            <div class="table-responsive mt-3">
                                <table class="table table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th>Libro</th>
                                            <th>Cantidad</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var detalle in entrada.Detalles)
                                        {
                                            <tr>
                                                <td>@ObtenerTitulo(detalle.LibroId)</td>
                                                <td>@detalle.Cantidad</td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => QuitarLibro(detalle)">
                                                        Quitar
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mt-3 mb-0">Agrega al menos un libro para guardar la entrada.</p>
                        }

                        <div class="text-end fw-semibold">
                            Total de unidades: @entrada.Total
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="Volver">Cancelar</button>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Entrada entrada = new();
    private List<Libro> libros = new();
    private int libroSeleccionadoId;
    private int cantidadDetalle = 1;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        var librosResultado = await LibrosServicio.GetList(libro => true);

        if (librosResultado.IsSuccess)
            libros = librosResultado.Value;
        else
            toastService.ShowError(librosResultado.Error.Description);

        var resultado = await Servicio.Buscar(Id);

        if (resultado.IsSuccess && resultado.Value is not null)
            entrada = resultado.Value;
        else
        {
            toastService.ShowError(resultado.IsFailure ? resultado.Error.Description : "No se encontro la entrada.");
            navigationManager.NavigateTo("/Entradas");
        }

        cargando = false;
    }

    private void AgregarLibro()
    {
        if (libroSeleccionadoId <= 0 || cantidadDetalle <= 0)
        {
            toastService.ShowError("Selecciona un libro e indica una cantidad mayor que cero.");
            return;
        }

        if (!libros.Any(libro => libro.LibroId == libroSeleccionadoId))
        {
            toastService.ShowError("No se encontro el libro seleccionado.");
            return;
        }

        var detalleExistente = entrada.Detalles.FirstOrDefault(detalle => detalle.LibroId == libroSeleccionadoId);

        if (detalleExistente is null)
        {
            entrada.Detalles.Add(new EntradasDetalle
            {
                LibroId = libroSeleccionadoId,
                Cantidad = cantidadDetalle
            });
        }
        else
        {
            detalleExistente.Cantidad += cantidadDetalle;
        }

        ActualizarTotal();
        cantidadDetalle = 1;
    }

    private void QuitarLibro(EntradasDetalle detalle)
    {
        entrada.Detalles.Remove(detalle);
        ActualizarTotal();
    }

    private void ActualizarTotal()
    {
        entrada.Total = entrada.Detalles.Sum(detalle => detalle.Cantidad);
    }

    private string ObtenerTitulo(int libroId)
    {
        return libros.FirstOrDefault(libro => libro.LibroId == libroId)?.Titulo
            ?? $"Libro {libroId}";
    }

    private async Task Guardar()
    {
        if (entrada.Detalles.Count == 0)
        {
            toastService.ShowError("Agrega por lo menos un libro antes de guardar.");
            return;
        }

        ActualizarTotal();
        var resultado = await Servicio.Guardar(entrada);

        if (resultado.IsSuccess)
        {
            toastService.ShowSuccess("Entrada actualizada correctamente.");
            navigationManager.NavigateTo("/Entradas");
        }
        else
        {
            toastService.ShowError(resultado.Error.Description);
        }
    }

    private void Volver() => navigationManager.NavigateTo("/Entradas");
}
