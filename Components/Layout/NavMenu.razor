<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">RegistroLibro</a>
        <button title="Menu de navegacion" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        
        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu me-2" aria-hidden="true"></span>
                <span>Inicio</span>
            </NavLink>
        </div>

        
        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="libros">
                <span class="bi bi-book-half me-2" aria-hidden="true"></span>
                <span>Consulta de libros</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="libros/crear">
                <span class="bi bi-plus-square-fill-nav-menu me-2" aria-hidden="true"></span>
                <span>Registrar libro</span>
            </NavLink>
        </div>

        
        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="estudiantes">
                <span class="bi bi-people-fill me-2" aria-hidden="true"></span>
                <span>Consulta de estudiantes</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="estudiantes/crear">
                <span class="bi bi-person-plus-fill me-2" aria-hidden="true"></span>
                <span>Registrar estudiante</span>
            </NavLink>
        </div>

       
        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="prestamos">
                <span class="bi bi-journal-check me-2" aria-hidden="true"></span>
                <span>Consulta de prestamos</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="prestamos/crear">
                <span class="bi bi-bookmark-plus-fill me-2" aria-hidden="true"></span>
                <span>Nuevo prestamo</span>
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}